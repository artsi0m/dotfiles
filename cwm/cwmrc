fontname "Iosevka:size=12"
gap 50 10 10 10
borderwidth 10
command term "xterm"
command lock "xscreensaver-command -lock"

unbind-key all
bind-key S4-ampersand "rofi -show drun"
bind-key C4-ampersand menu-exec
bind-key S4-Return term

bind-key 4-q lock
bind-key C4-q restart # that would reset all labels
bind-key 4S-q menu-exec-wm
bind-key C4S-q quit

bind-key 4-Return window-hide
bind-key 4-Down window-lower
bind-key 4-Up window-raise
bind-key 4-slash menu-window
bind-key 4-l window-menu-label

bind-key 4-0 window-close

bind-key M-Tab window-cycle
bind-key 4-Tab window-cycle-ingroup

bind-key 4-s window-stick


bind-key 4-f window-maximize
bind-key 4S-f window-fullscreen


bind-key 4-a group-toggle-all
bind-key 4-s window-vtile
bind-key 4-t window-htile
bind-key 4-g window-group

## Move windows across groups with
bind-key 4-1 group-toggle-1
bind-key 4-2 group-toggle-2
bind-key 4-3 group-toggle-3
bind-key 4-4 group-toggle-4
bind-key 4-5 group-toggle-5
bind-key 4-6 group-toggle-6
bind-key 4-7 group-toggle-7
bind-key 4-8 group-toggle-8
bind-key 4-9 group-toggle-9

# neio instead of hjkl

bind-key 4-n window-move-left-big
bind-key 4-e window-move-up-big
bind-key 4-i window-move-down-big
bind-key 4-o window-move-right-big

bind-key 4C-n window-resize-left
bind-key 4C-e window-resize-up
bind-key 4C-i window-resize-down
bind-key 4C-o window-resize-right

bind-key 4SC-n window-resize-left-big
bind-key 4SC-e window-resize-up-big
bind-key 4SC-i window-resize-down-big
bind-key 4SC-o window-resize-right-big


